[Unit]
Description=Ghost Trader Polymarket Research Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__WORKDIR__
EnvironmentFile=__ENV_FILE__
ExecStart=/bin/bash __WORKDIR__/scripts/start_dashboard.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
