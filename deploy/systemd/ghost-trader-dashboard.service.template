[Unit]
Description=Ghost Trader Ops Dashboard
After=network-online.target ghost-trader.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=__ENV_FILE__
ExecStart=__START_SCRIPT__
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
