[Unit]
Description=Ghost Trader Polymarket Paper Copy Lane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__WORKDIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__ENV_FILE__
ExecStart=/bin/bash __WORKDIR__/scripts/start_polymarket_copy.sh
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
